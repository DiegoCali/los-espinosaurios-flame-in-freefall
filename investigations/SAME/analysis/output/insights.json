  "key_insights": [
    {
      "id": "K1",
      "objective": "reproduce_nasa_results",
      "statement": "The moment-method statistics re-derived here match the published SAME-2 Table 1: the diameter of average mass agrees within 11% for all 10 material × aging cases.",
      "evidence": [
        "data/processed/size_dataset.csv",
        "data/processed/published_table1_baseline.csv"
      ],
      "confidence": "high"
    },
    {
      "id": "K2",
      "objective": "particle_size_by_material",
      "statement": "Kapton and Teflon (wire-insulation polymers) produce the smallest smoke: Dm 0.10–0.23 µm, versus 0.29–0.56 µm for lampwick (cellulose), Pyrell foam and silicone rubber at 8 cm/s flow.",
      "evidence": [
        "analysis-same.json#/size/by_material"
      ],
      "confidence": "high"
    },
    {
      "id": "K3",
      "objective": "aging_coagulation",
      "statement": "With flow, 527–793 s of extra aging cut the particle count to 27%–50% of its initial value and grew Dm by ×1.25–1.56. The growth equals the mass-conserving coagulation prediction (N0/N)^1/3, giving a coagulation coefficient of 9.0e-10 cm³/s, consistent with NASA's note (1.2e-09–1.7e-09) and Brownian theory.",
      "evidence": [
        "analysis-same.json#/aging/pairs",
        "data/processed/figures/aging_coagulation.png"
      ],
      "confidence": "high"
    },
    {
      "id": "K4",
      "objective": "aging_distribution_width",
      "statement": "Aging narrowed the size distribution (σg fell) in 11 of 12 flow runs, the trend expected as coagulating smoke approaches a self-preserving distribution.",
      "evidence": [
        "analysis-same.json#/aging/pairs"
      ],
      "confidence": "medium"
    },
    {
      "id": "K5",
      "objective": "microgravity_no_flow",
      "statement": "Without flow (possible only in microgravity, where there is no buoyant plume) smoke had ×1.4–3.3 larger Dm and 7–18× fewer particles, and further aging changed it little because it had already coagulated near the heater.",
      "evidence": [
        "analysis-same.json#/flow_effect",
        "data/processed/figures/flow_effect.png"
      ],
      "confidence": "medium"
    },
    {
      "id": "K6",
      "objective": "detector_comparison",
      "statement": "The two detection principles fail in opposite regimes. With 8 cm/s flow the ISS photoelectric (scattering) detector responded to 71% of pushes and the ionization chamber to 93%; for Kapton the ISS detector responded to only 27%. Without flow the ISS detector responded to 90% and the ionization chamber to 10%. Either detector would have responded to 95% of all pushes.",
      "evidence": [
        "analysis-same.json#/detectors",
        "data/processed/figures/detector_comparison.png",
        "data/processed/figures/threshold_sensitivity.png"
      ],
      "confidence": "medium"
    },
    {
      "id": "K7",
      "objective": "shuttle_detector",
      "statement": "The Space Shuttle ionization smoke detector (powered in 9 pushes) alarmed in 6; it stayed silent for aged Kapton (test 70), a weak Teflon test (89) and a dilute lampwick test (92).",
      "evidence": [
        "analysis-same.json#/detectors/sts_pushes"
      ],
      "confidence": "medium"
    },
    {
      "id": "K8",
      "objective": "predictive_model",
      "statement": "The AutoResearch-selected model predicts held-out Dm within a typical factor of 1.23 and M0 within 1.35, and reduces the detection Brier score by 51% relative to the prevalence; its combined score is 0.529 versus 1.043 for the mean baseline.",
      "evidence": [
        "runs/autoresearch/same-run-01/best.json",
        "data/processed/figures/model_cv.png"
      ],
      "confidence": "medium"
    },
    {
      "id": "K9",
      "objective": "tem_vs_moments",
      "statement": "TEM image sizing of lampwick grids gives mean diameters ×1.7–2.7 the in-flight moment value: small particles and liquid droplets are under-counted on grids, so in-flight moments are the better number statistic.",
      "evidence": [
        "data/processed/tem_summary.csv",
        "data/processed/figures/size_distributions.png"
      ],
      "confidence": "medium"
    },
    {
      "id": "K10",
      "objective": "fire_safety_implication",
      "statement": "A single-moment detector is not enough for spacecraft: overheated wire insulation (Kapton, Teflon) in ventilated areas makes ~0.1 µm smoke that light scattering misses, while smoke trapped in still air (avionics boxes, stagnant corners) is dilute and coarse and weakens the ionization signal. Measuring two moments (e.g. the MPASS demonstrated on SAME-R, or combining ionization and scattering) covers both cases.",
      "evidence": [
        "K2",
        "K5",
        "K6"
      ],
      "confidence": "medium"
    }
  ]
